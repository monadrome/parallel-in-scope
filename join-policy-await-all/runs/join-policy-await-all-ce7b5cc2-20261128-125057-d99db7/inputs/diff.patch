diff --git a/core/src/main/java/io/github/monadrome/parallelinscope/JoinPolicy.java b/core/src/main/java/io/github/monadrome/parallelinscope/JoinPolicy.java
new file mode 100644
index 00000000..d9a37ac6
--- /dev/null
+++ b/core/src/main/java/io/github/monadrome/parallelinscope/JoinPolicy.java
@@ -0,0 +1,31 @@
+package io.github.monadrome.parallelinscope;
+
+/**
+ * When a batch or group decides its outcome, declared once per scope at admission through {@link
+ * BatchOptions#joinPolicy(JoinPolicy)} or {@link GroupStart#joinPolicy(JoinPolicy)}.
+ *
+ * <p>The policy changes only when the scope's outcome is decided. Once it is decided, everything
+ * still running is cancelled and interrupted exactly as before. A deadline, a {@code cancelOn}
+ * source, an enclosing scope's cancellation, and {@code close()} cancel the scope under either
+ * policy. Either way the scope termination is the first failure in input or declaration order when
+ * any member failed (see {@link ScopeTermination}), and {@code orThrow()} throws that failure.
+ */
+public enum JoinPolicy {
+
+    /**
+     * The default. The first member that does not succeed decides the outcome: a failure or a
+     * direct member cancellation cancels every unfinished sibling, which ends {@code CANCELLED}
+     * with {@link CancellationReason.Kind#ABORTED_BY_FAIL_FAST}.
+     */
+    FAIL_FAST,
+
+    /**
+     * The outcome is decided when every member has settled. A member failure or a direct member
+     * cancellation ends only that member; its siblings run to completion and keep their own
+     * results, and a batch's sliding window keeps submitting the remaining elements. A declared
+     * terminal combine still runs only when every member succeeded: when the last member settles
+     * and any member did not succeed, the combine is cancelled without running, with {@link
+     * CancellationReason.Kind#ABORTED_BY_FAIL_FAST}.
+     */
+    AWAIT_ALL
+}
