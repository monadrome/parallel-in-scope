+    private static final Duration TIMEOUT = Duration.ofSeconds(30);
+    private static final TaskKey<String> M0 = TaskKey.named("m0");
+    private static final TaskKey<String> M1 = TaskKey.named("m1");
+    private static final Logger AGGREGATE_FUTURE =
+            Logger.getLogger("com.google.common.util.concurrent.AggregateFuture");
