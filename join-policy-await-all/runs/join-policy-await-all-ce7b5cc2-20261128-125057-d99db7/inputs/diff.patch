+        TerminationAssertions.assertCancelled(
+                result.results().get(1).termination(), CancellationReason.Kind.DEADLINE_EXCEEDED);
+        TerminationAssertions.assertScopeFailed(result.termination());
+        assertThatThrownBy(result::orThrow).isSameAs(failure);
+    }
+
+    @Test
+    void cancelOnStillCancelsAnAwaitAllBatch() {
+        pool = Executors.newFixedThreadPool(2);
+        runtime = ParRuntime.builder().register(ParId.of("pool"), pool).build();
+        SettableFuture<Void> stop = SettableFuture.create();
+        CountDownLatch bothStarted = new CountDownLatch(2);
+
+        TaskBatchResult<Integer> result = runtime.par(ParId.of("pool"))
+                .map(
+                        Arrays.asList(0, 1),
+                        index -> {
+                            bothStarted.countDown();
+                            if (index == 0) {
+                                SettleSignallingExecutor.await(bothStarted);
+                                stop.set(null);
+                            }
+                            blockUntilInterrupted();
+                            return index;
+                        },
+                        BatchOptions.timeout("cancel-on", TIMEOUT)
+                                .cancelOn(stop)
+                                .joinPolicy(JoinPolicy.AWAIT_ALL));
+
+        for (ImmediateResult<Integer> element : result.results()) {
+            TerminationAssertions.assertCancelled(
+                    element.termination(), CancellationReason.Kind.CANCELLED_BY_PARENT_SCOPE);
+        }
+        TerminationAssertions.assertScopeCancelled(result.termination(), CancellationReason.Kind.CANCELLED_BY_CALLER);
+    }
+
+    @Test
+    void anEnclosingScopeStillCancelsAnAwaitAllChild() {
+        pool = Executors.newFixedThreadPool(2);
+        innerPool = Executors.newFixedThreadPool(1);
+        runtime = ParRuntime.builder()
+                .register(ParId.of("pool"), pool)
+                .register(ParId.of("inner"), innerPool)
+                .build();
+        Par inner = runtime.par(ParId.of("inner"));
+        CountDownLatch innerStarted = new CountDownLatch(1);
+        AtomicReference<TaskBatchResult<Integer>> innerResult = new AtomicReference<>();
+
+        TaskBatchResult<Integer> outer = runtime.par(ParId.of("pool"))
+                .map(
+                        Arrays.asList(0, 1),
+                        index -> {
+                            if (index == 0) {
+                                innerResult.set(inner.map(
+                                        Arrays.asList(10),
+                                        value -> {
+                                            innerStarted.countDown();
+                                            blockUntilInterrupted();
+                                            return value;
+                                        },
+                                        BatchOptions.inheritTimeout("inner").joinPolicy(JoinPolicy.AWAIT_ALL)));
+                                return index;
+                            }
+                            SettleSignallingExecutor.await(innerStarted);
+                            throw new IllegalStateException("outer sibling");
+                        },
+                        BatchOptions.timeout("outer", TIMEOUT));
+
+        TerminationAssertions.assertScopeFailed(outer.termination());
+        TaskBatchResult<Integer> child = verifyNotNull(innerResult.get());
+        TerminationAssertions.assertCancelled(
+                child.results().get(0).termination(), CancellationReason.Kind.CANCELLED_BY_PARENT_SCOPE);
+    }
+
+    @Test
+    void theDefaultPolicyIsFailFast() {
+        assertThat(BatchOptions.timeout("batch", TIMEOUT).joinPolicy()).isEqualTo(JoinPolicy.FAIL_FAST);
+        assertThat(BatchOptions.inheritTimeout("batch").joinPolicy()).isEqualTo(JoinPolicy.FAIL_FAST);
+        assertThat(BatchOptions.timeout("batch", TIMEOUT)
+                        .joinPolicy(JoinPolicy.AWAIT_ALL)
+                        .parallelism(2)
+                        .closeGrace(Duration.ZERO)
+                        .rejectEnqueue(true)
+                        .cancelOn(SettableFuture.create())
+                        .joinPolicy())
+                .isEqualTo(JoinPolicy.AWAIT_ALL);
+    }
+
+    @Test
+    void aGroupJoinPolicyIsDeclaredBeforeTheFirstMember() {
+        runtime = ParRuntime.builder().build();
+        GroupStart start = runtime.group("late", TIMEOUT);
+        GroupStep step = start.adopt(TaskKey.<String>named("m0"), SettableFuture.<String>create());
+
+        assertThatThrownBy(() -> start.joinPolicy(JoinPolicy.AWAIT_ALL)).isInstanceOf(IllegalStateException.class);
+        assertThat(step).isNotNull();
+    }
+
+    /**
+     * Submits an {@code AWAIT_ALL} group of two adopted members, {@link #M0} over {@code first} and
+     * {@link #M1} over {@code last}, with a combine on a direct executor.
+     */
+    private TaskGroup<String> adoptedPairWithCombine(
+            String name,
+            SettableFuture<String> first,
+            SettableFuture<String> last,
+            Combiner<GroupValues, String> combiner) {
+        runtime = ParRuntime.builder()
+                .register(
+                        ParId.of("direct"), com.google.common.util.concurrent.MoreExecutors.newDirectExecutorService())
+                .build();
+        return runtime.groupDraft(name, TIMEOUT)
+                .joinPolicy(JoinPolicy.AWAIT_ALL)
+                .adopt(M0, first)
+                .adopt(M1, last)
+                .combine(TaskKey.<String>named("combine"), runtime.par(ParId.of("direct")), combiner)
+                .submitAll();
+    }
+
+    private SettleSignallingExecutor signallingPool(int threads, int expectedHandoffs) {
+        pool = Executors.newFixedThreadPool(threads);
+        SettleSignallingExecutor executor = new SettleSignallingExecutor(pool, expectedHandoffs);
+        runtime = ParRuntime.builder().register(ParId.of("pool"), executor).build();
+        return executor;
+    }
+
+    private static void blockUntilInterrupted() {
+        try {
+            new CountDownLatch(1).await(30, TimeUnit.SECONDS);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+        }
+    }
+}
