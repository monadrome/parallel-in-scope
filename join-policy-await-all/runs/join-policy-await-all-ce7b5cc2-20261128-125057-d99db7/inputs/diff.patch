diff --git a/core/src/test/java/io/github/monadrome/parallelinscope/SettleSignallingExecutor.java b/core/src/test/java/io/github/monadrome/parallelinscope/SettleSignallingExecutor.java
new file mode 100644
index 00000000..4d36d0ef
--- /dev/null
+++ b/core/src/test/java/io/github/monadrome/parallelinscope/SettleSignallingExecutor.java
@@ -0,0 +1,92 @@
+package io.github.monadrome.parallelinscope;
+
+import java.util.List;
+import java.util.concurrent.AbstractExecutorService;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicReference;
+
+/**
+ * Forwards every handoff to a delegate pool, counts the handoffs, and signals when the run that
+ * executed the marked task has returned. A prepared task future settles inside its own run, so
+ * the signal means the marked task's future has settled and every listener its settle ran on that
+ * thread, including a fail-fast cascade, has returned.
+ */
+final class SettleSignallingExecutor extends AbstractExecutorService {
+    private final ExecutorService delegate;
+    private final CountDownLatch handedOff;
+    private final CountDownLatch markedRunReturned = new CountDownLatch(1);
+    private final AtomicReference<Thread> markedRun = new AtomicReference<>();
+
+    SettleSignallingExecutor(ExecutorService delegate, int expectedHandoffs) {
+        this.delegate = delegate;
+        this.handedOff = new CountDownLatch(expectedHandoffs);
+    }
+
+    /** Marks the run executing on the calling thread; call it from inside the task code. */
+    void markCurrentRun() {
+        markedRun.set(Thread.currentThread());
+    }
+
+    /** Released once the marked run has returned. */
+    CountDownLatch markedRunReturned() {
+        return markedRunReturned;
+    }
+
+    /** Counted down after each handoff to the delegate. */
+    CountDownLatch handedOff() {
+        return handedOff;
+    }
+
+    @Override
+    public void execute(Runnable command) {
+        delegate.execute(() -> {
+            try {
+                command.run();
+            } finally {
+                if (markedRun.compareAndSet(Thread.currentThread(), null)) {
+                    markedRunReturned.countDown();
+                }
+            }
+        });
+        handedOff.countDown();
+    }
+
+    @Override
+    public void shutdown() {
+        delegate.shutdown();
+    }
+
+    @Override
+    public List<Runnable> shutdownNow() {
+        return delegate.shutdownNow();
+    }
+
+    @Override
+    public boolean isShutdown() {
+        return delegate.isShutdown();
+    }
+
+    @Override
+    public boolean isTerminated() {
+        return delegate.isTerminated();
+    }
+
+    @Override
+    public boolean awaitTermination(long timeout, TimeUnit unit) throws InterruptedException {
+        return delegate.awaitTermination(timeout, unit);
+    }
+
+    /** Waits up to ten seconds for {@code latch}, failing the test when it is not released. */
+    static void await(CountDownLatch latch) {
+        try {
+            if (!latch.await(10, TimeUnit.SECONDS)) {
+                throw new AssertionError("latch was not released");
+            }
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new AssertionError("interrupted while waiting", e);
+        }
+    }
+}
