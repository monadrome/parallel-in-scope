+    /** Shutting down every subsystem: one subsystem's failure must not skip the others' shutdown. */
+    @Test
+    void aShutdownGroupStopsEverySubsystemAndReportsEachOutcome() {
+        SettleSignallingExecutor executor = signallingPool(3, 3);
+        Par subsystems = runtime.par(ParId.of("pool"));
+        TaskKey<String> cache = TaskKey.named("cache");
+        TaskKey<String> database = TaskKey.named("database");
+        TaskKey<String> queue = TaskKey.named("queue");
+        TaskKey<String> summary = TaskKey.named("summary");
+        IllegalStateException cacheStuck = new IllegalStateException("cache did not flush");
+        AtomicBoolean summaryRan = new AtomicBoolean();
+
+        TaskGroupResult<String> result = runtime.group("shutdown", TIMEOUT)
+                .joinPolicy(JoinPolicy.AWAIT_ALL)
+                .par(cache, subsystems, () -> {
+                    executor.markCurrentRun();
+                    throw cacheStuck;
+                })
+                .par(database, subsystems, () -> {
+                    SettleSignallingExecutor.await(executor.markedRunReturned());
+                    return "database closed";
+                })
+                .par(queue, subsystems, () -> {
+                    SettleSignallingExecutor.await(executor.markedRunReturned());
+                    return "queue drained";
+                })
+                .combine(summary, subsystems, values -> {
+                    summaryRan.set(true);
+                    return "all stopped";
+                })
+                .runAll();
+
+        assertThat(result.results()).hasSize(3);
+        TerminationAssertions.assertUserFailure(result.resultOf(cache).termination());
+        assertThat(result.resultOf(database).termination().value()).isEqualTo("database closed");
+        assertThat(result.resultOf(queue).termination().value()).isEqualTo("queue drained");
+        TerminationAssertions.assertCancelled(
+                verifyNotNull(result.terminalResult()).termination(), CancellationReason.Kind.ABORTED_BY_FAIL_FAST);
+        assertThat(summaryRan).isFalse();
+        TerminationAssertions.assertScopeFailed(result.termination());
+        assertThat(result.termination().failedTask()).isEqualTo("cache");
+        assertThat(result.failedTaskName()).isEqualTo("cache");
+        assertThatThrownBy(result::orThrow).isSameAs(cacheStuck);
+        assertThat(result.executionExitConfirmed()).isTrue();
+    }
