+        TerminationAssertions.assertScopeFailed(result.termination(), FailureCause.Kind.USER_CODE_FAILURE);
+        assertThat(result.termination().failure()).isSameAs(pricingDown);
+        assertThatThrownBy(result::orThrow).isSameAs(pricingDown);
+    }
