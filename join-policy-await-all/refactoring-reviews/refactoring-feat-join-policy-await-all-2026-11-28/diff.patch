+    // ---- Token ----
+
+    @Test
+    void anAwaitAllTokenCompletesOnlyWhenEveryBoundFutureSettledAndNeverCommitsFailFast() {
+        timer = Executors.newSingleThreadScheduledExecutor();
+        CancellationToken token = new CancellationToken();
+        List<SettableFuture<String>> futures = PreparedStates.bindAwaitingAll(token, 3, timer);
+
+        futures.get(0).setException(new IllegalStateException("first"));
+        futures.get(1).cancel(false);
+
+        assertThat(token.state()).isEqualTo(CancellationToken.State.RUNNING);
+        assertThat(futures.get(2).isCancelled()).isFalse();
+
+        futures.get(2).set("last");
+
+        assertThat(token.state()).isEqualTo(CancellationToken.State.COMPLETED);
+    }
+
+    @Test
+    void aCompletedAwaitAllParentDoesNotCancelItsChild() {
