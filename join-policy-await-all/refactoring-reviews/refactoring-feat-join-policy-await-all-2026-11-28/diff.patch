diff --git a/core/src/test/java/io/github/monadrome/parallelinscope/ScopeTerminationOrderTest.java b/core/src/test/java/io/github/monadrome/parallelinscope/ScopeTerminationOrderTest.java
new file mode 100644
index 00000000..144dbd31
--- /dev/null
+++ b/core/src/test/java/io/github/monadrome/parallelinscope/ScopeTerminationOrderTest.java
@@ -0,0 +1,118 @@
+package io.github.monadrome.parallelinscope;
+
+import static com.google.common.base.Verify.verifyNotNull;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import com.google.common.util.concurrent.SettableFuture;
+import java.time.Duration;
+import java.util.Arrays;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+import java.util.logging.Level;
+import java.util.logging.Logger;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.Timeout;
+
+/**
+ * A scope's termination is a function of its frozen results, not of the order in which they
+ * settled: when two elements of one batch fail, {@code termination()} names the same failure that
+ * {@code orThrow()} throws and {@code failedTaskResult()} returns, the first in input order.
+ */
+@Timeout(value = 60, threadMode = Timeout.ThreadMode.SEPARATE_THREAD)
+class ScopeTerminationOrderTest {
+
+    private static final Duration TIMEOUT = Duration.ofSeconds(30);
+
+    @Test
+    void aLaterElementThatFailsFirstDoesNotNameTheBatchFailure() {
+        CancellationToken token = new CancellationToken();
+        SettableFuture<String> first = SettableFuture.create();
+        SettableFuture<String> second = SettableFuture.create();
+        TaskBatch<String> batch = PreparedStates.batchOver(token, Arrays.asList(first, second));
+        IllegalStateException secondFailure = new IllegalStateException("second");
+        IllegalStateException firstFailure = new IllegalStateException("first");
+        second.setException(secondFailure);
+        first.setException(firstFailure);
+
+        TaskBatchResult<String> result = batch.finish();
+
+        assertSelectsTheFirstFailureInInputOrder(result, firstFailure);
+    }
+
+    /**
+     * End to end on a pool: element 1 fails first and commits the batch's fail-fast; a token state
+     * listener holds that commit until element 0 has failed with its own business exception, so
+     * both elements are recorded {@code FAILED} and the later-indexed one settled first.
+     */
+    @Test
+    void twoElementFailuresSettlingOutOfInputOrderNameTheFirstInInputOrder() throws Exception {
+        ExecutorService pool = Executors.newFixedThreadPool(2);
+        SettleSignallingExecutor executor = new SettleSignallingExecutor(pool, 2);
+        CountDownLatch listenerRegistered = new CountDownLatch(1);
+        CountDownLatch failNow = new CountDownLatch(1);
+        ParRuntime runtime =
+                ParRuntime.builder().register(ParId.of("pool"), executor).build();
+        Thread caller = Thread.currentThread();
+        IllegalStateException firstFailure = new IllegalStateException("element 0");
+        IllegalStateException secondFailure = new IllegalStateException("element 1");
+        Logger aggregateFuture = Logger.getLogger("com.google.common.util.concurrent.AggregateFuture");
+        Level previousLevel = aggregateFuture.getLevel();
+        try {
+            aggregateFuture.setLevel(Level.OFF);
+            TaskBatchResult<String> result = runtime.par(ParId.of("pool"))
+                    .map(
+                            Arrays.asList(0, 1),
+                            index -> {
+                                if (index == 0) {
+                                    executor.markCurrentRun();
+                                    CancellationToken batchToken = verifyNotNull(TaskExecutionContext.current())
+                                            .multiTaskContext()
+                                            .cancellationToken();
+                                    batchToken.addStateListener(state -> {
+                                        failNow.countDown();
+                                        SettleSignallingExecutor.await(executor.markedRunReturned());
+                                    });
+                                    listenerRegistered.countDown();
+                                    SettleSignallingExecutor.await(failNow);
+                                    throw firstFailure;
+                                }
+                                SettleSignallingExecutor.await(listenerRegistered);
+                                SettleSignallingExecutor.await(executor.handedOff());
+                                awaitCallerParked(caller);
+                                throw secondFailure;
+                            },
+                            BatchOptions.timeout("out-of-order", TIMEOUT));
+
+            TerminationAssertions.assertUserFailure(result.results().get(0).termination());
+            TerminationAssertions.assertUserFailure(result.results().get(1).termination());
+            assertSelectsTheFirstFailureInInputOrder(result, firstFailure);
+        } finally {
+            aggregateFuture.setLevel(previousLevel);
+            runtime.close();
+            pool.shutdownNow();
+        }
+    }
+
+    private static void assertSelectsTheFirstFailureInInputOrder(
+            TaskBatchResult<String> result, Throwable firstFailure) {
+        assertThat(result.failedTaskResult().map(ImmediateResult::failure)).containsSame(firstFailure);
+        assertThatThrownBy(result::orThrow).isSameAs(firstFailure);
+        TerminationAssertions.assertScopeFailed(result.termination());
+        assertThat(result.termination().failure()).isSameAs(firstFailure);
+    }
+
+    /**
+     * Waits until the caller is parked in the batch's freeze wait, so the batch result object exists
+     * before element 1 settles: the interleaving under which the removed arrival-order observer saw
+     * element 1 first.
+     */
+    private static void awaitCallerParked(Thread caller) {
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(10);
+        while (caller.getState() != Thread.State.WAITING && System.nanoTime() < deadline) {
+            Thread.yield();
+        }
+    }
+}
