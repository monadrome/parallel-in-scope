+                BatchOptions.timeout("quotes", TIMEOUT).joinPolicy(JoinPolicy.AWAIT_ALL));
+
+        assertThat(result.results()).hasSize(4);
+        assertThat(result.results().get(0).termination().value()).isEqualTo("quote-sku-a");
+        TerminationAssertions.assertUserFailure(result.results().get(1).termination());
+        assertThat(result.results().get(1).failure()).isSameAs(pricingDown);
+        assertThat(result.results().get(2).termination().value()).isEqualTo("quote-sku-c");
+        assertThat(result.results().get(3).termination().value()).isEqualTo("quote-sku-d");
+        assertThat(result.terminationKindCounts())
+                .containsEntry(TaskTermination.Kind.SUCCESS, 3)
+                .containsEntry(TaskTermination.Kind.FAILED, 1)
