-        private FailingSizeQueue(int failingCall, Throwable failure) {
-            this.failingCall = failingCall;
-            this.failure = failure;
-        }
-
-        @Override
-        public int size() {
-            int size = super.size();
-            if (sizeCalls.get() == failingCall) {
-                if (failure instanceof Error) {
-                    throw (Error) failure;
-                }
-                throw (RuntimeException) failure;
-            }
-            return size;
-        }
