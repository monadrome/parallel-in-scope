        AtomicReference<TaskBatchResult<Integer>> resultRef = new AtomicReference<>();
        try {
            Thread runner = new Thread(() -> resultRef.set(par.map(List.of(1), x -> {
                entered.countDown();
                ignoreInterruptionUntil(exit);
                return x;
