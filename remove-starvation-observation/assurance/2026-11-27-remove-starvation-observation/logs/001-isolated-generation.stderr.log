```
@Test
void closeDoesNotWaitForRunningWorkAndKeepsRegisteredExecutorUsable() throws Exception {
  ThreadPoolExecutor pool = new ThreadPoolExecutor(2,2,0L,TimeUnit.MILLISECONDS,new LinkedBlockingQueue<>());
  ParRuntime runtime = null;
  try {
    runtime = ParRuntime.builder().register(ParId.of("io"), pool).defaultPar(ParId.of("io")).build();
    Par par = runtime.defaultPar();
    CountDownLatch started = new CountDownLatch(1);
    CountDownLatch release = new CountDownLatch(1);
    AtomicReference<TaskBatchResult<Integer>> ref = new AtomicReference<>();
    Thread runner = new Thread(() -> ref.set(par.map(List.of(1), x -> {
        started.countDown();
        try { release.await(10, TimeUnit.SECONDS); } catch (InterruptedException ignored) { }
        return x;
    }, BatchOptions.timeout("b", Duration.ofSeconds(10)))));
    runner.start();
    assertThat(started.await(10, TimeUnit.SECONDS)).isTrue();
    runtime.close();
    assertThat(runtime.closed()).isTrue();
    // work still running (release not counted)
    assertThat(release.getCount()).isEqualTo(1);
    // executor not shut down
    assertThat(pool.isShutdown()).isFalse();
    assertThat(pool.isTerminated()).isFalse();
    // executor still accepts and runs work directly
    Future<Integer> direct = pool.submit(() -> 42);
    assertThat(direct.get(10, TimeUnit.SECONDS)).isEqualTo(42);
    // release the admitted run; it must still complete
    release.countDown();
    runner.join(10_000);
    assertThat(runner.isAlive()).isFalse();
    TaskBatchResult<Integer> result = ref.get();
    assertThat(result.executionExitConfirmed()).isTrue();
    assertThat(result.valuesOrThrow()).containsExactly(1);
  } finally {
    if (runtime != null) runtime.close();
    pool.shutdownNow();
  }
}
```
