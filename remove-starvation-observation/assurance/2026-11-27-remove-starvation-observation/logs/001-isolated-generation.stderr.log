@Test
void awaitQuiescenceWaitsForCancelledExecutionThatIgnoresInterruption() throws Exception {
  ThreadPoolExecutor pool = new ThreadPoolExecutor(1,1,0,MILLISECONDS,new LinkedBlockingQueue<>());
  ParRuntime runtime = builder.register(id,pool).defaultPar(id).build();
  Par par = runtime.defaultPar();
  CountDownLatch entered = new CountDownLatch(1);
  CountDownLatch exit = new CountDownLatch(1);
  AtomicBoolean interrupted = new AtomicBoolean(false);
  AtomicReference<TaskBatchResult<Integer>> ref = new AtomicReference<>();
  Thread runner = new Thread(() -> {
     ref.set(par.map(List.of(1), x -> {
        entered.countDown();
        // ignore interruption for up to 5s
        while (!exit.await(5, TimeUnit.SECONDS)) { /* ignore */ }
        return x;
     }, BatchOptions.timeout("b", Duration.ofMillis(200))));
  });
  runner.start();
  entered.await(10, SECONDS);
  // Wait until the map call's deadline expired and its future settled cancelled
  // The map waits for results (already cancelled at 200ms) then bounded cleanup; cleanup wait derived from remaining deadline ~0, so map returns soon.
  // Actually the map call itself is synchronous; it returns when results settle AND bounded cleanup attempted.
