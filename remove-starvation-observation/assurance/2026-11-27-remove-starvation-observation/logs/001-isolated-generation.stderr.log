+                    BatchOptions.timeout("b", Duration.ofSeconds(1))))
+                    .isInstanceOf(IllegalStateException.class);
+
+            TaskKey<Integer> member = TaskKey.named("member");
+            assertThatThrownBy(() -> runtime.group("g", Duration.ofSeconds(1))
+                    .par(member, par, () -> 1)
+                    .runAll())
+                    .isInstanceOf(IllegalStateException.class);
+        } finally {
+            runtime.close();
+            pool.shutdownNow();
+        }
+    }
+}
