+            assertThat(runner.isAlive()).isFalse();
+
+            TaskBatchResult<Integer> result = resultRef.get();
+            assertThat(result.executionExitConfirmed()).isTrue();
+            assertThat(result.valuesOrThrow()).containsExactly(1);
+        } finally {
+            release.countDown();
+            runtime.close();
+            pool.shutdownNow();
+        }
+    }
