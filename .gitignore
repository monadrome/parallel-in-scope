# Build output
target/
__pycache__/

# IDE
.idea/
*.iml

# Eclipse
.classpath
.factorypath
.project
.settings/

# OS
.DS_Store

# Scratch and editor reports (regenerated locally, never committed)
index.html
script.js
styles.css
graph-viz/
tmp/
todo/

# Local LLM review benchmark evidence (raw logs and derived records stay local)
.review-benchmark/

# Claude (track project skills; keep local settings and worktrees ignored)
.claude/*
!.claude/skills/
!.claude/skills/**

# Local senate tooling state and its design draft
.senate/

# ZCode local harness state
.zcode/

# Kiro local harness state
.kiro/

# Playwright MCP scratch output
.playwright-mcp/

# Local skill installs and Firecrawl fetch cache (per-machine, never committed)
.agents/
.firecrawl/
skills-lock.json

# Local property-test state left behind by jqwik runs
.jqwik-database

# Historical repair evaluator secrets and raw model transcripts. Keep only
# status summaries in Git; patches, hidden tests, and session logs stay outside
# the model-visible checkout.
historical-eval/catalog/model-runs/all/
historical-eval/catalog/model-runs/*/candidate.patch
historical-eval/catalog/model-runs/*/session.patch
historical-eval/catalog/model-runs/*/session.json
historical-eval/catalog/model-runs/*/session.session.log

# Local planning state
.planning/
**/task_plan.md
**/findings.md
**/progress.md

# Local worktrees
.worktrees/

# MkDocs build output
mkdocs/site/
