Let me write the loader:

```python
_VERIFIER = None

def _verifier():
    global _VERIFIER
    if _VERIFIER is not None:
        return _VERIFIER
    path = os.environ.get("VERIFY_RUN_PATH")
    if not path:
        raise unittest.SkipTest("VERIFY_RUN_PATH is not set")
    module_path = Path(path)
    spec = importlib.util.spec_from_file_location("verify_run", module_path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load verifier from {path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    _VERIFIER = module
    return module
```

