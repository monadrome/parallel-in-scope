    contract_gaps = b"# gaps\n"
    cand_status = b"candidate_id\n"
    promo_status = b"candidate_id,source_contract_id,contract_id,target_path,archive_path,status,reason\n"
    verif_summary = b"# summary\n"
    if accepted:
        report = b"# report\nFinal gate: PASS WITH ACCEPTED EXCEPTIONS\n"
    else:
        report = b"# report\nFinal gate: PASS\n"
    write files...
    # inputs real file
    sample = b"input sample\n"
    (root/'inputs'/'sample.txt').write_bytes(sample)
    base = '1'*40; head = '2'*40
    adapter = {"requiredGates": ["candidate-tests"]}
    accepted_exceptions = []
    if accepted:
        adapter["acceptedDispositions"] = {...}
        accepted_exceptions = [...]
    manifest = {
      "schemaVersion": "contract-assurance-run/v2",
      "runId": "run-0001",
      "createdAt": "2026-11-24T00:00:00Z",
      "package": {},
      "adapter": adapter,
      "workspace": {"base": base, "head": head, "dirty": False},
      "inputs": {"inputs/sample.txt": _sha256_bytes(sample)},
      "commands": [],
      "artifacts": {name: sha for the 6 files},
      "status": "pass",
      "requiredGates": ["candidate-tests"],
      "checks": {"candidate-tests": "pass"},
      "acceptedExceptions": accepted_exceptions,
      "finalHead": head,
    }
    write run-manifest.json
    return manifest
```

