package:
  name: contract-first-assurance
  version: 1.5.2
  schema: 1
  entrypoint: SKILL.md
  layout: sibling-skills
  description: Independent contract-based assurance for repository changes.

components:
  - path: ../contract-extract
    kind: phase
    version: 1.5.2
  - path: ../isolated-test-generation
    kind: phase
    version: 1.5.2
  - path: ../contract-diff
    kind: phase
    version: 1.5.2
  - path: ../assurance-report
    kind: phase
    version: 1.5.2

references:
  invocation: references/invocation-modes.md
  host_adapter: references/host-adapter.md
  reproducible_runs: references/reproducible-runs.md
  mutation_dispositions: references/mutation-dispositions.md

host_adapters:
  - path: adapters/vformation.yaml
    applies_to: parallel-in-scope
    version: 1.5.2

runtime:
  required:
    - git
    - isolated-worktree
    - fresh-agent-context
  optional:
    - mutation-runner

outputs:
  default_root: .contract-first-assurance
  required_files:
    - run-manifest.json
    - inputs/
    - logs/
    - contract.md
    - contract-gaps.md
    - candidates/
    - candidate-status.csv
    - promotions/
    - promotion-status.csv
    - reverse-verification/
    - verification-summary.md
    - report.md
---adapters---
name: vformation
version: 1.5.2
workspace_root: repository-root
base_ref: origin/dev/v0.5.0
artifact_root: .contract-first-assurance

change_scope:
  default: current-branch-diff

contract_paths:
  - AGENTS.md
  - design/
  - adr/
  - verification/

public_api_paths:
  - core/src/main/java/

build_commands:
  compile: mvn -DskipTests compile
  targeted_tests: mvn test -Dtest='<ClassName>#<methodName>'
  full_suite: mvn test

regression_suite:
  path: verification/contract-tests/
  check_command: python3 scripts/check-contract-tests.py
  test_command: mvn -Pcontract-tests -pl verification/contract-tests -am clean test
  execution_check_command: python3 scripts/check-contract-tests.py --reports verification/contract-tests/target/surefire-reports

format_commands:
  - mvn spotless:check
  - python3 scripts/check-doc-refs.py

mutation_policy:
  applies: true
  instructions: verification/pit.md
  runner: PIT scope is selected and reported according to verification/pit.md
  accepted_dispositions:
    EXPECTED_MUTATION_LIVENESS:
      allowed_raw_statuses: [TIMED_OUT]
      required_evidence:
        - repeatable-focused-rerun
        - unmutated-tests-pass
        - complete-xml-and-logs
        - source-level-liveness-invariant
        - maintainer-or-independent-review

route_gates:
  mechanical:
    required: [narrow-checks, docs]
  defect:
    required: [regression-tests, related-tests]
  contract:
    required: [full-suite, consumer, pit, independent-review, docs]
  concurrency:
    required: [full-suite, race-claims, pit, independent-review, refactoring-review, docs]
  docs:
    required: [docs]
  dependency:
    required: [dependency-audit, maven, consumer]

status_policy:
  values: [pass, fail, blocked, inconclusive, skipped]
  precedence: [fail, blocked, inconclusive, pass, skipped]
  spawn_errors: blocked
  interrupted_process: inconclusive
  skipped_requires_route_reason: true

execution_policy:
  freeze_final_head: true
  record_worktree_snapshot: true
  retry_transient_failures: 1
  retry_timeout_or_interrupt: false
  terminate_process_group: true

isolation:
  source_paths:
    - core/src/main/java/
  test_paths:
    - core/src/test/java/

