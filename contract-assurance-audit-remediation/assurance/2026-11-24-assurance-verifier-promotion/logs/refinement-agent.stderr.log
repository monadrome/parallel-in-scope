    Path(__file__).resolve().parents[2]
    / ".agents/skills/contract-first-assurance/scripts/verify_run.py"
)
_spec = importlib.util.spec_from_file_location("verify_run", VERIFY_RUN)
_verify_run = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(_verify_run)

REQUIRED_DIRS = ("inputs", "logs", "candidates", "promotions", "reverse-verification")
EVIDENCE_CATEGORIES = (
