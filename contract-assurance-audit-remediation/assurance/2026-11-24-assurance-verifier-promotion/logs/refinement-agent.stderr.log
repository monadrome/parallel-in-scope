import hashlib
import unittest
from pathlib import Path

try:
    from tests.test_verify_run import VerifyRunTest, verify_run
except ImportError:
    from test_verify_run import VerifyRunTest, verify_run


class ContractVerifierTest(unittest.TestCase):
