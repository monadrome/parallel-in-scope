        self._verify = VerifyRunTest()
        self.addCleanup(self._verify.doCleanups)

    def test_CONTRACT_TDD_021_C0004_nested_input_symlink(self):
        run = self._verify.make_run(None, {}, final_gate=\"PASS\")
