"""Promoted regression test for contract C-0001 (candidate CONTRACT-TDD-008).

Rejects a policy using ``rawStatuses`` instead of ``allowedRawStatuses``.
"""
import hashlib
import importlib.util
import json
import tempfile
import unittest
from pathlib import Path

