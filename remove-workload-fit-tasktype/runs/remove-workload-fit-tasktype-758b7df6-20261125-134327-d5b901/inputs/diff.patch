--- /dev/null
+++ b/verification/pit-audit/2026-11-24-remove-tasktype/scripts/pit_sleep.py
@@ -0,0 +1,43 @@
+"""Report, per PIT run, its wall-clock span and how long the host slept during it.
+
+Usage: pit_sleep.py <sleep-wake.txt> <run-meta.txt>...
+
+The sleep/wake file holds `pmset -g log` events as "<date> <time> <Sleep|Wake|DarkWake>" in the
+host's local time (UTC-8 here). A sleep interval runs from an "Entering Sleep" event to the next
+wake event. Each run-meta file supplies "started:" and "finished:" UTC timestamps.
+"""
+import datetime
+import sys
+from pathlib import Path
+
+UTC_OFFSET = datetime.timedelta(hours=8)
+events = []
+for line in open(sys.argv[1]):
+    day, time, kind = line.split()
+    events.append((datetime.datetime.strptime(f"{day} {time}", "%Y-%m-%d %H:%M:%S") + UTC_OFFSET, kind))
+
+
+def asleep(start, end):
+    total, count, began = 0.0, 0, None
+    for stamp, kind in events:
+        if kind == "Sleep":
+            began = stamp
+        elif began is not None:
+            low, high = max(began, start), min(stamp, end)
+            if high > low:
+                total += (high - low).total_seconds()
+                count += 1
+            began = None
+    return count, int(total)
+
+
+for meta in sys.argv[2:]:
+    fields = dict(line.split(": ", 1) for line in open(meta).read().splitlines() if ": " in line)
+    if "finished" not in fields:
+        print(f"{Path(meta).stem}: unfinished")
+        continue
+    parse = lambda key: datetime.datetime.strptime(fields[key].split()[0], "%Y-%m-%dT%H:%M:%SZ")
+    start, end = parse("started"), parse("finished")
+    count, total = asleep(start, end)
+    print(f"{Path(meta).stem}: {start:%Y-%m-%dT%H:%M:%S}Z..{end:%H:%M:%S}Z "
+          f"span={int((end - start).total_seconds())}s sleeps={count} asleep={total}s")
diff --git a/verification/pit-audit/2026-11-24-remove-tasktype/scripts/pit_status_table.py b/verification/pit-audit/2026-11-24-remove-tasktype/scripts/pit_status_table.py
new file mode 100644
index 00000000..96fe34ee
--- /dev/null
+++ b/verification/pit-audit/2026-11-24-remove-tasktype/scripts/pit_status_table.py
@@ -0,0 +1,41 @@
+"""Print each listed method's non-KILLED mutants with their status in every given PIT report.
+
+Usage: pit_status_table.py <Class.method>[,<Class.method>...] <label>=<mutations.xml[.gz]>...
+
+Mutants are matched by class, method, mutator, description, and order of appearance, so the
+table lines up the same mutant across revisions whose line numbers differ.
+"""
+import collections
+import gzip
+import sys
+import xml.etree.ElementTree as ET
+
+wanted = set(sys.argv[1].split(","))
+reports = [arg.split("=", 1) for arg in sys.argv[2:]]
+table = collections.defaultdict(dict)
+for label, path in reports:
+    source = gzip.open(path) if path.endswith(".gz") else open(path, "rb")
+    seen = collections.Counter()
+    for mutant in ET.parse(source).getroot():
+        cls = mutant.findtext("mutatedClass").rsplit(".", 1)[1]
+        method = mutant.findtext("mutatedMethod")
+        if f"{cls.split('$')[0]}.{method}" not in wanted and f"{cls}.{method}" not in wanted:
+            continue
+        key = (cls, method, mutant.findtext("mutator").rsplit(".", 1)[1], mutant.findtext("description"))
+        ordinal = seen[key]
+        seen[key] += 1
+        killer = (mutant.findtext("killingTest") or "").split("[method:")[-1].split("[test-template:")[-1]
+        table[key + (ordinal,)][label] = (mutant.findtext("lineNumber"), mutant.get("status"),
+                                          mutant.get("numberOfTestsRun"), killer.rstrip("()]"))
+for key in sorted(table):
+    row = table[key]
+    if all(cell[1] == "KILLED" for cell in row.values()):
+        continue
+    print(f"{key[0]}.{key[1]} {key[2]} #{key[4]} '{key[3]}'")
+    for label, _ in reports:
+        cell = row.get(label)
+        if cell is None:
+            print(f"    {label}: absent")
+        else:
+            line, status, tests, killer = cell
+            print(f"    {label}: line {line} {status} after {tests} test(s){' by ' + killer if killer else ''}")
