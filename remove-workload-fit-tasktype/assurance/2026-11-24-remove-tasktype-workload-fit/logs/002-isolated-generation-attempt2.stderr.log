@@ -0,0 +1,132 @@
+package io.github.monadrome.parallelinscope.assurance;
+
+import io.github.monadrome.parallelinscope.BatchOptions;
+import io.github.monadrome.parallelinscope.Par;
+import io.github.monadrome.parallelinscope.ParId;
+import io.github.monadrome.parallelinscope.ParRuntime;
+import java.time.Duration;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+import java.util.logging.Handler;
+import java.util.logging.Level;
+import java.util.logging.LogRecord;
+import java.util.logging.Logger;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * CONTRACT-TDD-012 (contract C-3).
+ *
+ * <p>Precondition: one entry on a plain executor with several idle workers.
+ *
+ * <p>Operation sequence: eight threads admit a refusing single-element batch through the same
+ * entry simultaneously, released together by a start latch.
+ *
+ * <p>Observation points: JUL records naming the entry id.
+ *
+ * <p>Assertions: the entry still causes exactly one {@code WARNING}, even under concurrent first
+ * admissions; the count stays one after a 1000 millisecond window.
+ *
+ * <p>Uncertainty: the once-only guarantee is asserted after all admissions return; a record that
+ * arrived late would still be within the stated window.
+ */
+public class ContractTdd012ConcurrentFirstAdmissionsOnceTest {
+
+    @Test
+    void concurrentFirstAdmissionsStillWarnOnce() throws Exception {
+        ExecutorService pool = Executors.newFixedThreadPool(8);
+        ParId id = ParId.of("ct012-entry");
+        Logger logger = Logger.getLogger("io.github.monadrome.parallelinscope");
+        CaptureHandler handler = new CaptureHandler();
+        logger.addHandler(handler);
+
+        try (ParRuntime runtime = ParRuntime.builder().register(id, pool).build()) {
+            Par par = runtime.par(id);
+            BatchOptions refusing = BatchOptions.timeout("ct012-batch", Duration.ofSeconds(30))
+                    .rejectEnqueue(true);
+            List<Integer> one = Arrays.asList(1);
+
+            int threads = 8;
+            CountDownLatch ready = new CountDownLatch(threads);
+            CountDownLatch start = new CountDownLatch(1);
+            Thread[] workers = new Thread[threads];
+            for (int i = 0; i < threads; i++) {
+                workers[i] = new Thread(() -> {
+                    ready.countDown();
+                    try {
+                        start.await(10, TimeUnit.SECONDS);
+                        par.map(one, el -> el, refusing);
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                    }
+                });
+                workers[i].start();
+            }
+
+            assertThat(ready.await(10, TimeUnit.SECONDS)).isTrue();
+            start.countDown();
+            for (Thread worker : workers) {
+                worker.join(TimeUnit.SECONDS.toMillis(20));
+            }
+
+            handler.awaitCountContaining("ct012-entry", 1, 10);
+            assertThat(handler.countContaining("ct012-entry")).isEqualTo(1);
+            assertThat(handler.firstContaining("ct012-entry").getLevel()).isEqualTo(Level.WARNING);
+            Thread.sleep(1000);
+            assertThat(handler.countContaining("ct012-entry")).isEqualTo(1);
+        } finally {
+            logger.removeHandler(handler);
+            pool.shutdownNow();
+        }
+    }
+
+    private static final class CaptureHandler extends Handler {
+        final List<LogRecord> records = Collections.synchronizedList(new java.util.ArrayList<>());
+
+        @Override
+        public void publish(LogRecord record) {
+            records.add(record);
+        }
+
+        @Override
+        public void flush() {
+        }
+
+        @Override
+        public void close() {
+        }
+
+        int countContaining(String fragment) {
+            int count = 0;
+            for (LogRecord record : records) {
+                if (record.getMessage() != null && record.getMessage().contains(fragment)) {
+                    count++;
+                }
+            }
+            return count;
+        }
+
+        LogRecord firstContaining(String fragment) {
+            for (LogRecord record : records) {
+                if (record.getMessage() != null && record.getMessage().contains(fragment)) {
+                    return record;
+                }
+            }
+            return null;
+        }
+
+        void awaitCountContaining(String fragment, int expected, long seconds)
+                throws InterruptedException {
+            long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(seconds);
+            while (countContaining(fragment) < expected && System.nanoTime() < deadline) {
+                Thread.sleep(50);
+            }
+        }
+    }
+}
diff --git a/candidates/ContractTdd013OffThreadBlockingHandlerTest.java b/candidates/ContractTdd013OffThreadBlockingHandlerTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..e08dee6a52bc6ce0574804dc0f844d157492bcb5
--- /dev/null
+++ b/candidates/ContractTdd013OffThreadBlockingHandlerTest.java
@@ -0,0 +1,130 @@
+package io.github.monadrome.parallelinscope.assurance;
+
+import io.github.monadrome.parallelinscope.BatchOptions;
+import io.github.monadrome.parallelinscope.Par;
+import io.github.monadrome.parallelinscope.ParId;
+import io.github.monadrome.parallelinscope.ParRuntime;
+import io.github.monadrome.parallelinscope.TaskBatchResult;
+import java.time.Duration;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.logging.Handler;
+import java.util.logging.Level;
+import java.util.logging.LogRecord;
+import java.util.logging.Logger;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * CONTRACT-TDD-013 (contract C-4).
+ *
+ * <p>Precondition: one entry on a plain executor; a handler under O-1 that records the publishing
+ * thread and blocks on a latch when a matching record is published.
+ *
+ * <p>Operation sequence: a dedicated thread admits a refusing batch; the test waits for the
+ * handler to start, joins the admitting thread while the handler is still blocked, then releases
+ * the handler.
+ *
+ * <p>Observation points: the publishing thread, whether the record is delivered before release,
+ * and the admitting thread's return.
+ *
+ * <p>Assertions: the admitting thread returns while the handler is still blocked (a blocking
+ * handler never delays the caller); the publishing thread is not the admitting thread; the record
+ * is published only after the handler is released.
+ *
+ * <p>Uncertainty: the runtime-owned thread's identity is not fixed; only "not the admitting
+ * thread" is asserted.
+ */
+public class ContractTdd013OffThreadBlockingHandlerTest {
+
+    @Test
+    void diagnosticIsDeliveredOffThreadAndNeverBlocksCaller() throws Exception {
+        ExecutorService pool = Executors.newFixedThreadPool(2);
+        ParId id = ParId.of("ct013-entry");
+        Logger logger = Logger.getLogger("io.github.monadrome.parallelinscope");
+        BlockingHandler handler = new BlockingHandler("ct013-entry");
+        logger.addHandler(handler);
+
+        AtomicReference<TaskBatchResult<Integer>> resultRef = new AtomicReference<>();
+        AtomicReference<Throwable> errorRef = new AtomicReference<>();
+
+        try (ParRuntime runtime = ParRuntime.builder().register(id, pool).build()) {
+            Par par = runtime.par(id);
+            BatchOptions refusing = BatchOptions.timeout("ct013-batch", Duration.ofSeconds(30))
+                    .rejectEnqueue(true);
+            List<Integer> one = Arrays.asList(1);
+
+            Thread admitThread = new Thread(() -> {
+                try {
+                    resultRef.set(par.map(one, el -> el, refusing));
+                } catch (Throwable t) {
+                    errorRef.set(t);
+                }
+            });
+            admitThread.start();
+
+            assertThat(handler.started.await(10, TimeUnit.SECONDS)).isTrue();
+            admitThread.join(TimeUnit.SECONDS.toMillis(10));
+            assertThat(admitThread.isAlive()).isFalse();
+            assertThat(errorRef.get()).isNull();
+            assertThat(handler.records).isEmpty();
+            assertThat(handler.publishThread.get()).isNotNull();
+            assertThat(handler.publishThread.get()).isNotSameAs(admitThread);
+
+            handler.release.countDown();
+            assertThat(handler.delivered.await(10, TimeUnit.SECONDS)).isTrue();
+            assertThat(handler.records).hasSize(1);
+            assertThat(handler.records.get(0).getLevel()).isEqualTo(Level.WARNING);
+            assertThat(handler.records.get(0).getMessage())
+                    .startsWith("Par 'ct013-entry' requested rejectEnqueue");
+            assertThat(resultRef.get().termination().successful()).isTrue();
+        } finally {
+            handler.release.countDown();
+            logger.removeHandler(handler);
+            pool.shutdownNow();
+        }
+    }
+
+    private static final class BlockingHandler extends Handler {
+        final String fragment;
+        final CountDownLatch started = new CountDownLatch(1);
+        final CountDownLatch release = new CountDownLatch(1);
+        final CountDownLatch delivered = new CountDownLatch(1);
+        final AtomicReference<Thread> publishThread = new AtomicReference<>();
+        final List<LogRecord> records = Collections.synchronizedList(new java.util.ArrayList<>());
+
+        BlockingHandler(String fragment) {
+            this.fragment = fragment;
+        }
+
+        @Override
+        public void publish(LogRecord record) {
+            if (record.getMessage() != null && record.getMessage().contains(fragment)) {
+                publishThread.set(Thread.currentThread());
+                started.countDown();
+                try {
+                    release.await(10, TimeUnit.SECONDS);
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                }
+                records.add(record);
+                delivered.countDown();
+            }
+        }
+
+        @Override
+        public void flush() {
+        }
+
+        @Override
+        public void close() {
+        }
+    }
+}
diff --git a/candidates/ContractTdd014ThrowingHandlerNoOutcomeChangeTest.java b/candidates/ContractTdd014ThrowingHandlerNoOutcomeChangeTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..8072da2482d57d8b97dfa93fb9191e64781fc700
--- /dev/null
+++ b/candidates/ContractTdd014ThrowingHandlerNoOutcomeChangeTest.java
@@ -0,0 +1,103 @@
+package io.github.monadrome.parallelinscope.assurance;
+
+import io.github.monadrome.parallelinscope.BatchOptions;
+import io.github.monadrome.parallelinscope.Par;
+import io.github.monadrome.parallelinscope.ParId;
+import io.github.monadrome.parallelinscope.ParRuntime;
+import io.github.monadrome.parallelinscope.TaskBatchResult;
+import java.time.Duration;
+import java.util.Arrays;
+import java.util.List;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+import java.util.logging.Handler;
+import java.util.logging.LogRecord;
+import java.util.logging.Logger;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * CONTRACT-TDD-014 (contract C-4).
+ *
+ * <p>Precondition: one entry on a plain executor; a handler under O-1 that throws a
+ * {@link RuntimeException} while publishing a matching record.
+ *
+ * <p>Operation sequence: admit a refusing batch, then an identical non-refusing batch with the
+ * same mapping function.
+ *
+ * <p>Observation points: whether the {@code map} calls return and their frozen values.
+ *
+ * <p>Assertions: a throwing handler changes no outcome — the refusing batch returns normally with
+ * the same values and success termination as the identical non-refusing batch; the exception never
+ * reaches the caller; only that record is lost.
+ *
+ * <p>Uncertainty: "only that record is lost" is asserted indirectly; the record list stays empty
+ * because the throwing handler never stores it.
+ */
+public class ContractTdd014ThrowingHandlerNoOutcomeChangeTest {
+
+    @Test
+    void throwingHandlerDoesNotChangeOutcome() throws Exception {
+        ExecutorService pool = Executors.newFixedThreadPool(2);
+        ParId id = ParId.of("ct014-entry");
+        Logger logger = Logger.getLogger("io.github.monadrome.parallelinscope");
+        ThrowingHandler handler = new ThrowingHandler("ct014-entry");
+        logger.addHandler(handler);
+
+        try (ParRuntime runtime = ParRuntime.builder().register(id, pool).build()) {
+            Par par = runtime.par(id);
+            BatchOptions refusing = BatchOptions.timeout("ct014-batch", Duration.ofSeconds(30))
+                    .rejectEnqueue(true);
+            BatchOptions normal = BatchOptions.timeout("ct014-batch", Duration.ofSeconds(30));
+            List<Integer> input = Arrays.asList(1, 2, 3);
+
+            TaskBatchResult<Integer> refusingResult = par.map(input, el -> el * 2, refusing);
+            handler.awaitInvoked(1, 10);
+            assertThat(refusingResult.termination().successful()).isTrue();
+            assertThat(refusingResult.valuesOrThrow()).containsExactly(2, 4, 6);
+
+            TaskBatchResult<Integer> normalResult = par.map(input, el -> el * 2, normal);
+            assertThat(normalResult.termination().successful()).isTrue();
+            assertThat(normalResult.valuesOrThrow()).containsExactly(2, 4, 6);
+            assertThat(refusingResult.valuesOrThrow()).isEqualTo(normalResult.valuesOrThrow());
+        } finally {
+            logger.removeHandler(handler);
+            pool.shutdownNow();
+        }
+    }
+
+    private static final class ThrowingHandler extends Handler {
+        final String fragment;
+        final CountDownLatch invoked = new CountDownLatch(1);
+
+        ThrowingHandler(String fragment) {
+            this.fragment = fragment;
+        }
+
+        @Override
+        public void publish(LogRecord record) {
+            if (record.getMessage() != null && record.getMessage().contains(fragment)) {
+                invoked.countDown();
+                throw new RuntimeException("logging failure");
+            }
+        }
+
+        @Override
+        public void flush() {
+        }
+
+        @Override
+        public void close() {
+        }
+
+        void awaitInvoked(int expected, long seconds) throws InterruptedException {
+            long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(seconds);
+            while (invoked.getCount() > 0 && System.nanoTime() < deadline) {
+                Thread.sleep(50);
+            }
+        }
+    }
+}
diff --git a/candidates/ContractTdd015RegistrationAndCycleWarningsTest.java b/candidates/ContractTdd015RegistrationAndCycleWarningsTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..382f6db0682c9043edbe79ca2b1aaf166fae437b
--- /dev/null
+++ b/candidates/ContractTdd015RegistrationAndCycleWarningsTest.java
@@ -0,0 +1,204 @@
+package io.github.monadrome.parallelinscope.assurance;
+
+import io.github.monadrome.parallelinscope.BatchOptions;
+import io.github.monadrome.parallelinscope.Par;
+import io.github.monadrome.parallelinscope.ParId;
+import io.github.monadrome.parallelinscope.ParRuntime;
+import java.time.Duration;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ForkJoinPool;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.logging.Handler;
+import java.util.logging.Level;
+import java.util.logging.LogRecord;
+import java.util.logging.Logger;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * CONTRACT-TDD-015 (contract C-4).
+ *
+ * <p>Precondition: handlers under O-1; a {@link ForkJoinPool} (an executor the library cannot see
+ * through) and a plain fixed pool; later a single-thread fixed pool for a self-wait.
+ *
+ * <p>Operation sequence: (A) build a runtime with a throwing handler while registering a
+ * {@code ForkJoinPool}; (B) build a runtime registering a {@code ForkJoinPool} and a fixed pool
+ * with a capturing handler; (C) admit a batch element that nested-calls {@code map} on its own
+ * entry, forming a self-cycle.
+ *
+ * <p>Observation points: whether {@code build()} returns, JUL record levels, publishing threads,
+ * and {@code ExecutorWaitReport.cyclicComponents()}.
+ *
+ * <p>Assertions: a throwing handler does not make {@code build()} fail; the registration warning
+ * names the {@code ForkJoinPool} entry and is published off the building thread; the fixed entry
+ * causes no warning; the self-cycle produces one {@code WARNING} from a thread other than the
+ * submitting one and {@code cyclicComponents()} reports the cycle.
+ *
+ * <p>Uncertainty: registration and cycle wording is non-contractual; filtering uses candidate
+ * entry ids.
+ */
+public class ContractTdd015RegistrationAndCycleWarningsTest {
+
+    @Test
+    void registrationAndCycleWarningsAreOffThread() throws Exception {
+        Logger logger = Logger.getLogger("io.github.monadrome.parallelinscope");
+        Thread buildingThread = Thread.currentThread();
+
+        ThrowingHandler throwing = new ThrowingHandler();
+        logger.addHandler(throwing);
+        ForkJoinPool fjpThrow = new ForkJoinPool(1);
+        try (ParRuntime ignored = ParRuntime.builder()
+                .register(ParId.of("ct015-fjpthrow"), fjpThrow)
+                .build()) {
+            assertThat(ignored).isNotNull();
+        } finally {
+            logger.removeHandler(throwing);
+            fjpThrow.shutdownNow();
+        }
+
+        CaptureHandler capture = new CaptureHandler();
+        logger.addHandler(capture);
+        ForkJoinPool fjp = new ForkJoinPool(1);
+        ExecutorService fixed = Executors.newFixedThreadPool(2);
+        ParId fjpId = ParId.of("ct015-fjp");
+        ParId fixedId = ParId.of("ct015-fixed");
+        try (ParRuntime registrationRuntime = ParRuntime.builder()
+                .register(fjpId, fjp)
+                .register(fixedId, fixed)
+                .build()) {
+            assertThat(registrationRuntime).isNotNull();
+            capture.awaitCountContaining("ct015-fjp", 1, 10);
+            assertThat(capture.countContaining("ct015-fjp")).isEqualTo(1);
+            assertThat(capture.firstContaining("ct015-fjp").getLevel()).isEqualTo(Level.WARNING);
+            assertThat(capture.firstContaining("ct015-fjp").getThreadName())
+                    .isNotEqualTo(buildingThread.getName());
+            assertThat(capture.countContaining("ct015-fixed")).isZero();
+        } finally {
+            logger.removeHandler(capture);
+            fjp.shutdownNow();
+            fixed.shutdownNow();
+        }
+
+        CaptureHandler cycleCapture = new CaptureHandler();
+        logger.addHandler(cycleCapture);
+        ExecutorService selfPool = Executors.newFixedThreadPool(1);
+        ParId selfId = ParId.of("ct015-self");
+        AtomicReference<Thread> selfThread = new AtomicReference<>();
+        try (ParRuntime cycleRuntime = ParRuntime.builder()
+                .register(selfId, selfPool)
+                .build()) {
+            Par par = cycleRuntime.par(selfId);
+            BatchOptions outer = BatchOptions.timeout("ct015-outer", Duration.ofSeconds(20));
+            BatchOptions inner = BatchOptions.timeout("ct015-inner", Duration.ofSeconds(3));
+            par.map(Arrays.asList(1), el -> {
+                selfThread.set(Thread.currentThread());
+                return par.map(Arrays.asList(2), el2 -> el2, inner);
+            }, outer);
+
+            awaitCycleReported(cycleRuntime, Duration.ofSeconds(10));
+            assertThat(cycleRuntime.executorWaitReport().cyclicComponents()).isNotEmpty();
+            cycleCapture.awaitAnyWarning(1, 10);
+            assertThat(cycleCapture.records).isNotEmpty();
+            LogRecord cycleRecord = cycleCapture.records.get(0);
+            assertThat(cycleRecord.getLevel()).isEqualTo(Level.WARNING);
+            assertThat(cycleRecord.getThreadName()).isNotEqualTo(buildingThread.getName());
+            if (selfThread.get() != null) {
+                assertThat(cycleRecord.getThreadName()).isNotEqualTo(selfThread.get().getName());
+            }
+        } finally {
+            logger.removeHandler(cycleCapture);
+            selfPool.shutdownNow();
+        }
+    }
+
+    private static void awaitCycleReported(ParRuntime runtime, Duration timeout)
+            throws InterruptedException {
+        long deadline = System.nanoTime() + timeout.toNanos();
+        while (runtime.executorWaitReport().cyclicComponents().isEmpty()
+                && System.nanoTime() < deadline) {
+            Thread.sleep(50);
+        }
+    }
+
+    private static final class ThrowingHandler extends Handler {
+        @Override
+        public void publish(LogRecord record) {
+            throw new RuntimeException("logging failure");
+        }
+
+        @Override
+        public void flush() {
+        }
+
+        @Override
+        public void close() {
+        }
+    }
+
+    private static final class CaptureHandler extends Handler {
+        final List<LogRecord> records = Collections.synchronizedList(new java.util.ArrayList<>());
+
+        @Override
+        public void publish(LogRecord record) {
+            records.add(record);
+        }
+
+        @Override
+        public void flush() {
+        }
+
+        @Override
+        public void close() {
+        }
+
+        int countContaining(String fragment) {
+            int count = 0;
+            for (LogRecord record : records) {
+                if (record.getMessage() != null && record.getMessage().contains(fragment)) {
+                    count++;
+                }
+            }
+            return count;
+        }
+
+        LogRecord firstContaining(String fragment) {
+            for (LogRecord record : records) {
+                if (record.getMessage() != null && record.getMessage().contains(fragment)) {
+                    return record;
+                }
+            }
+            return null;
+        }
+
+        void awaitCountContaining(String fragment, int expected, long seconds)
+                throws InterruptedException {
+            long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(seconds);
+            while (countContaining(fragment) < expected && System.nanoTime() < deadline) {
+                Thread.sleep(50);
+            }
+        }
+
+        void awaitAnyWarning(int expected, long seconds) throws InterruptedException {
+            long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(seconds);
+            while (countWarnings() < expected && System.nanoTime() < deadline) {
+                Thread.sleep(50);
+            }
+        }
+
+        int countWarnings() {
+            int count = 0;
+            for (LogRecord record : records) {
+                if (record.getLevel().intValue() >= Level.WARNING.intValue()) {
+                    count++;
+                }
+            }
+            return count;
+        }
+    }
+}
diff --git a/candidates/ContractTdd016NoRetainedDiagnosticsTest.java b/candidates/ContractTdd016NoRetainedDiagnosticsTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..7dfc193bb95d52361fb95036ea724d9575b82604
--- /dev/null
+++ b/candidates/ContractTdd016NoRetainedDiagnosticsTest.java
@@ -0,0 +1,151 @@
+package io.github.monadrome.parallelinscope.assurance;
+
+import io.github.monadrome.parallelinscope.BatchOptions;
+import io.github.monadrome.parallelinscope.Combiner;
+import io.github.monadrome.parallelinscope.FailureCause;
+import io.github.monadrome.parallelinscope.GroupStart;
+import io.github.monadrome.parallelinscope.GroupStep;
+import io.github.monadrome.parallelinscope.GroupValues;
+import io.github.monadrome.parallelinscope.Par;
+import io.github.monadrome.parallelinscope.ParId;
+import io.github.monadrome.parallelinscope.ParRuntime;
+import io.github.monadrome.parallelinscope.SubmissionAwareBlockingQueue;
+import io.github.monadrome.parallelinscope.TaskBatchResult;
+import io.github.monadrome.parallelinscope.TaskGroupResult;
+import io.github.monadrome.parallelinscope.TaskKey;
+import io.github.monadrome.parallelinscope.TaskOptions;
+import java.time.Duration;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import java.util.logging.Handler;
+import java.util.logging.Level;
+import java.util.logging.LogRecord;
+import java.util.logging.Logger;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * CONTRACT-TDD-016 (contract C-5).
+ *
+ * <p>Precondition: entries on refusal-capable {@code ThreadPoolExecutor}s, default options, no
+ * nested waits, no open starvation observation.
+ *
+ * <p>Operation sequence: run a batch whose elements block (sleep) and where one throws, then a
+ * group whose members block and whose combine succeeds.
+ *
+ * <p>Observation points: element and member values, the batch termination, the failed element's
+ * cause, the group terminal value, and JUL records at {@code INFO} or above naming this candidate.
+ *
+ * <p>Assertions: blocking work completes with its values and a {@code USER_CODE_FAILURE} failure
+ * attribution; no workload-fit, task-type, or CPU-utilization record — no library record at
+ * {@code INFO} or above — is published within a 1500 millisecond window.
+ *
+ * <p>Uncertainty: absence is a bounded-window observation (O-2); the 1500 ms window is stated
+ * here.
+ */
+public class ContractTdd016NoRetainedDiagnosticsTest {
+
+    @Test
+    void blockingWorkKeepsOutcomesAndPublishesNoRetainedDiagnostics() throws Exception {
+        ThreadPoolExecutor batchPool = new ThreadPoolExecutor(
+                2, 2, 0L, TimeUnit.MILLISECONDS, new SubmissionAwareBlockingQueue<Runnable>(2));
+        ThreadPoolExecutor groupPool = new ThreadPoolExecutor(
+                2, 2, 0L, TimeUnit.MILLISECONDS, new SubmissionAwareBlockingQueue<Runnable>(2));
+        ParId batchId = ParId.of("ct016-batch");
+        ParId groupId = ParId.of("ct016-group");
+        Logger logger = Logger.getLogger("io.github.monadrome.parallelinscope");
+        CaptureHandler handler = new CaptureHandler();
+        logger.addHandler(handler);
+
+        try (ParRuntime runtime = ParRuntime.builder()
+                .register(batchId, batchPool)
+                .register(groupId, groupPool)
+                .build()) {
+            Par batchPar = runtime.par(batchId);
+            Par groupPar = runtime.par(groupId);
+
+            BatchOptions batchOptions = BatchOptions.timeout("ct016-batch", Duration.ofSeconds(30));
+            TaskBatchResult<String> batch = batchPar.map(Arrays.asList(0, 1),
+                    el -> {
+                        if (el == 0) {
+                            Thread.sleep(50);
+                            return "a";
+                        }
+                        Thread.sleep(200);
+                        throw new IllegalStateException("boom");
+                    },
+                    batchOptions);
+
+            assertThat(batch.results()).hasSize(2);
+            assertThat(batch.results().get(0).successful()).isTrue();
+            assertThat(batch.results().get(0).valueOrThrow()).isEqualTo("a");
+            assertThat(batch.results().get(1).successful()).isFalse();
+            assertThat(batch.results().get(1).failureCause()).isNotNull();
+            assertThat(batch.results().get(1).failureCause().kind())
+                    .isEqualTo(FailureCause.Kind.USER_CODE_FAILURE);
+            assertThat(batch.termination().successful()).isFalse();
+
+            TaskKey<Integer> leftKey = TaskKey.named("ct016-left");
+            TaskKey<Integer> rightKey = TaskKey.named("ct016-right");
+            TaskKey<Integer> combineKey = TaskKey.named("ct016-combine");
+            GroupStart start = runtime.group("ct016-group", Duration.ofSeconds(30));
+            GroupStep step = start.par(leftKey, groupPar,
+                    TaskOptions.timeout(Duration.ofSeconds(20)), () -> {
+                        Thread.sleep(100);
+                        return 5;
+                    });
+            step = step.par(rightKey, groupPar,
+                    TaskOptions.timeout(Duration.ofSeconds(20)), () -> {
+                        Thread.sleep(100);
+                        return 6;
+                    });
+            TaskGroupResult<Integer> group = step.combine(combineKey, groupPar,
+                    TaskOptions.timeout(Duration.ofSeconds(20)),
+                    (Combiner<GroupValues, Integer>) values ->
+                            values.valueOf(leftKey) + values.valueOf(rightKey)).runAll();
+
+            assertThat(group.termination().successful()).isTrue();
+            assertThat(group.terminalValueOrThrow()).isEqualTo(11);
+
+            Thread.sleep(1500);
+            assertThat(handler.countInfoOrAboveContaining("ct016-")).isZero();
+        } finally {
+            logger.removeHandler(handler);
+            batchPool.shutdownNow();
+            groupPool.shutdownNow();
+        }
+    }
+
+    private static final class CaptureHandler extends Handler {
+        final List<LogRecord> records = Collections.synchronizedList(new java.util.ArrayList<>());
+
+        @Override
+        public void publish(LogRecord record) {
+            records.add(record);
+        }
+
+        @Override
+        public void flush() {
+        }
+
+        @Override
+        public void close() {
+        }
+
+        int countInfoOrAboveContaining(String fragment) {
+            int count = 0;
+            for (LogRecord record : records) {
+                if (record.getLevel().intValue() >= Level.INFO.intValue()
+                        && record.getMessage() != null
+                        && record.getMessage().contains(fragment)) {
+                    count++;
+                }
+            }
+            return count;
+        }
+    }
+}
