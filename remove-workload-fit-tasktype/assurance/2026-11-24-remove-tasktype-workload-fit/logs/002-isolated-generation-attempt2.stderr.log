package io.github.monadrome.parallelinscope.assurance;

import ...
public class ContractTdd006BatchInertRefusalWarnOnceTest {
    private static final class Capture extends java.util.logging.Handler {
        final String fragment;
        final java.util.List<java.util.logging.LogRecord> records = java.util.Collections.synchronizedList(new java.util.ArrayList<>());
        final java.util.concurrent.CountDownLatch any = new java.util.concurrent.CountDownLatch(1);
        volatile java.util.concurrent.atomic.AtomicReference<Thread> publishThread = new java.util.concurrent.atomic.AtomicReference<>();
        Capture(String fragment) { this.fragment = fragment; }
        @Override public void publish(java.util.logging.LogRecord record) {
            if (record.getMessage() != null && record.getMessage().contains(fragment)) {
                publishThread.set(Thread.currentThread());
                records.add(record);
                any.countDown();
            }
        }
        @Override public void flush() {}
        @Override public void close() {}
        boolean awaitAny(long seconds) throws InterruptedException { return any.await(seconds, TimeUnit.SECONDS); }
        int count() { return records.size(); }
    }
    ...
}
```

