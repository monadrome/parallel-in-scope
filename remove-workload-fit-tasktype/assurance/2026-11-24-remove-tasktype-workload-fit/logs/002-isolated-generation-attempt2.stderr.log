--- /dev/null
+++ b/candidates/ContractTdd005MapAndCombineCombineNoRefusalQueuedTest.java
@@ -0,0 +1,125 @@
+package io.github.monadrome.parallelinscope.assurance;
+
+import io.github.monadrome.parallelinscope.BatchCombinedResult;
+import io.github.monadrome.parallelinscope.BatchOptions;
+import io.github.monadrome.parallelinscope.Combiner;
+import io.github.monadrome.parallelinscope.Par;
+import io.github.monadrome.parallelinscope.ParId;
+import io.github.monadrome.parallelinscope.ParRuntime;
+import io.github.monadrome.parallelinscope.SubmissionAwareBlockingQueue;
+import java.time.Duration;
+import java.util.Arrays;
+import java.util.List;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * CONTRACT-TDD-005 (contract C-2).
+ *
+ * <p>Precondition: a batch entry on a refusal-capable pool with headroom, and a combine entry on a
+ * refusal-capable pool (core=1, max=1, queue capacity 1) whose only worker is busy blocked on a
+ * latch.
+ *
+ * <p>Operation sequence: run {@code mapAndCombine} with a refusing batch
+ * ({@code rejectEnqueue(true)}) whose elements succeed immediately, and a terminal combine
+ * submitted to the busy combine entry. The test observes the combine pool's queue reach size one,
+ * releases the blocker, then joins.
+ *
+ * <p>Observation points: the combine pool's queue size before release and the terminal combine's
+ * frozen result and run counter.
+ *
+ * <p>Assertions: the combine is queued while the worker is busy and is not rejected — its
+ * {@code terminalResult()} succeeds and its combiner ran exactly once.
+ *
+ * <p>Uncertainty: the exact submission moment is not observable; queued-before-release is asserted
+ * by watching the pool queue, which is application code reading its own executor.
+ */
+public class ContractTdd005MapAndCombineCombineNoRefusalQueuedTest {
+
+    @Test
+    void mapAndCombineTerminalCombineIsQueuedNotRejected() throws Exception {
+        ThreadPoolExecutor batchPool = new ThreadPoolExecutor(
+                2, 2, 0L, TimeUnit.MILLISECONDS, new SubmissionAwareBlockingQueue<Runnable>(2));
+        ThreadPoolExecutor combinePool = new ThreadPoolExecutor(
+                1, 1, 0L, TimeUnit.MILLISECONDS, new SubmissionAwareBlockingQueue<Runnable>(1));
+        ParId batchId = ParId.of("ct005-batch");
+        ParId combineId = ParId.of("ct005-combine");
+
+        CountDownLatch started = new CountDownLatch(1);
+        CountDownLatch release = new CountDownLatch(1);
+        AtomicInteger combineRan = new AtomicInteger();
+
+        AtomicReference<BatchCombinedResult<Integer, Integer>> resultRef = new AtomicReference<>();
+        AtomicReference<Throwable> errorRef = new AtomicReference<>();
+
+        try (ParRuntime runtime = ParRuntime.builder()
+                .register(batchId, batchPool)
+                .register(combineId, combinePool)
+                .build()) {
+            Par batchPar = runtime.par(batchId);
+            Par combinePar = runtime.par(combineId);
+
+            combinePool.execute(() -> {
+                started.countDown();
+                try {
+                    release.await(10, TimeUnit.SECONDS);
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                }
+            });
+            assertThat(started.await(10, TimeUnit.SECONDS)).isTrue();
+
+            List<Integer> elements = Arrays.asList(1, 2);
+            BatchOptions options = BatchOptions.timeout("ct005-batch", Duration.ofSeconds(30))
+                    .rejectEnqueue(true);
+
+            Thread submitter = new Thread(() -> {
+                try {
+                    resultRef.set(batchPar.mapAndCombine(elements,
+                            el -> el,
+                            options,
+                            combinePar,
+                            (Combiner<List<Integer>, Integer>) values -> {
+                                combineRan.incrementAndGet();
+                                return values.size();
+                            }));
+                } catch (Throwable t) {
+                    errorRef.set(t);
+                }
+            });
+            submitter.start();
+
+            awaitQueueSize(combinePool, 1, Duration.ofSeconds(10));
+            release.countDown();
+            submitter.join(TimeUnit.SECONDS.toMillis(20));
+            assertThat(errorRef.get()).isNull();
+
+            BatchCombinedResult<Integer, Integer> result = resultRef.get();
+            assertThat(result.terminalResult().successful()).isTrue();
+            assertThat(result.terminalResult().termination().failureCause()).isNull();
+            assertThat(combineRan.get()).isEqualTo(1);
+        } finally {
+            batchPool.shutdownNow();
+            combinePool.shutdownNow();
+        }
+    }
+
+    private static void awaitQueueSize(
+            ThreadPoolExecutor pool, int expected, Duration timeout) throws InterruptedException {
+        long deadline = System.nanoTime() + timeout.toNanos();
+        while (System.nanoTime() < deadline) {
+            if (pool.getQueue().size() == expected) {
+                return;
+            }
+            Thread.sleep(20);
+        }
+        throw new AssertionError(
+                "queue did not reach size " + expected + " within " + timeout);
+    }
+}
diff --git a/candidates/ContractTdd006BatchInertRefusalWarnOnceTest.java b/candidates/ContractTdd006BatchInertRefusalWarnOnceTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..73a0b3de4a2747924221d34def50312b0e3011e2
--- /dev/null
+++ b/candidates/ContractTdd006BatchInertRefusalWarnOnceTest.java
@@ -0,0 +1,113 @@
+package io.github.monadrome.parallelinscope.assurance;
+
+import io.github.monadrome.parallelinscope.BatchOptions;
+import io.github.monadrome.parallelinscope.Par;
+import io.github.monadrome.parallelinscope.ParId;
+import io.github.monadrome.parallelinscope.ParRuntime;
+import java.time.Duration;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+import java.util.logging.Handler;
+import java.util.logging.Level;
+import java.util.logging.LogRecord;
+import java.util.logging.Logger;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * CONTRACT-TDD-006 (contract C-3).
+ *
+ * <p>Precondition: one entry on a plain executor ({@code Executors.newFixedThreadPool}). Operation
+ * sequence: admit a refusing batch, wait for its warning, admit a second refusing batch, then a
+ * non-refusing batch.
+ *
+ * <p>Observation points: JUL records published under the
+ * {@code io.github.monadrome.parallelinscope} logger whose message names this entry id.
+ *
+ * <p>Assertions: exactly one {@code WARNING} whose message starts with
+ * {@code Par 'ct006-entry' requested rejectEnqueue}; the later refusing and non-refusing admissions
+ * produce no further record within an observed window of 800 milliseconds.
+ *
+ * <p>Uncertainty: absence is a bounded-window observation per O-2; the 800 ms window is stated here.
+ */
+public class ContractTdd006BatchInertRefusalWarnOnceTest {
+
+    @Test
+    void batchInertRefusalWarnsOncePerEntry() throws Exception {
+        ExecutorService pool = Executors.newFixedThreadPool(2);
+        ParId id = ParId.of("ct006-entry");
+        Logger logger = Logger.getLogger("io.github.monadrome.parallelinscope");
+        CaptureHandler handler = new CaptureHandler("ct006-entry");
+        logger.addHandler(handler);
+
+        try (ParRuntime runtime = ParRuntime.builder().register(id, pool).build()) {
+            Par par = runtime.par(id);
+            BatchOptions refusing = BatchOptions.timeout("ct006-batch", Duration.ofSeconds(30))
+                    .rejectEnqueue(true);
+            BatchOptions normal = BatchOptions.timeout("ct006-batch", Duration.ofSeconds(30));
+            List<Integer> one = Arrays.asList(1);
+
+            par.map(one, el -> el, refusing);
+            handler.awaitCount(1, 10);
+            assertThat(handler.count()).isEqualTo(1);
+            assertThat(handler.records.get(0).getLevel()).isEqualTo(Level.WARNING);
+            assertThat(handler.records.get(0).getMessage())
+                    .startsWith("Par 'ct006-entry' requested rejectEnqueue");
+
+            par.map(one, el -> el, refusing);
+            sleepWindow(800);
+            assertThat(handler.count()).isEqualTo(1);
+
+            par.map(one, el -> el, normal);
+            sleepWindow(800);
+            assertThat(handler.count()).isEqualTo(1);
+        } finally {
+            logger.removeHandler(handler);
+            pool.shutdownNow();
+        }
+    }
+
+    private static void sleepWindow(long millis) throws InterruptedException {
+        Thread.sleep(millis);
+    }
+
+    private static final class CaptureHandler extends Handler {
+        final String fragment;
+        final List<LogRecord> records = Collections.synchronizedList(new java.util.ArrayList<>());
+
+        CaptureHandler(String fragment) {
+            this.fragment = fragment;
+        }
+
+        @Override
+        public void publish(LogRecord record) {
+            if (record.getMessage() != null && record.getMessage().contains(fragment)) {
+                records.add(record);
+            }
+        }
+
+        @Override
+        public void flush() {
+        }
+
+        @Override
+        public void close() {
+        }
+
+        int count() {
+            return records.size();
+        }
+
+        void awaitCount(int expected, long seconds) throws InterruptedException {
+            long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(seconds);
+            while (count() < expected && System.nanoTime() < deadline) {
+                Thread.sleep(50);
+            }
+        }
+    }
+}
