## io/github/monadrome/parallelinscope/ThreadPoolStarvationObservationScope.java

```java
package io.github.monadrome.parallelinscope;

import com.google.common.util.concurrent.ListenableFuture;
import java.util.concurrent.ThreadPoolExecutor;

/**
 * Explicit observation scope for starvation signals produced by unstructured executor work.
 *
 * <p>The scope samples each distinct physical {@link ThreadPoolExecutor} registered with its
 * owning {@link ParRuntime}. It never wraps or submits user work. Close the scope after the
 * unstructured activity of interest, then read {@link #reportFuture()}.
 *
 * <p>A pool is considered potentially starved when it has no free worker, queued work remains, and
 * its completed-task count stays unchanged across sample pairs separated by the requested
 * interval. The evidence is sticky for the observation window. The condition is deliberately
 * bounded and conservative: a long CPU-bound task can produce the same signal, so the report does
 * not claim a dependency cycle.
 */
public final class ThreadPoolStarvationObservationScope implements AutoCloseable {

    /** Returns the immutable report published when this scope closes. */
    public ListenableFuture<ThreadPoolStarvationReport> reportFuture();

    /** Returns whether close has begun; the report may still be publishing. */
    public boolean closed();

    /**
     * Stops sampling, performs the final sample, and publishes the report. Repeated or concurrent
     * calls wait for the same publication. Sampling failures are recorded in the report; a sampling
     * {@link Error} is rethrown only after report publication has been attempted.
     */
    @Override
    public void close();
}
```

## io/github/monadrome/parallelinscope/ThreadPoolStarvationReport.java

```java
package io.github.monadrome.parallelinscope;

import com.google.errorprone.annotations.Immutable;
import java.time.Duration;
import java.util.List;
import org.jspecify.annotations.Nullable;

/**
 * Immutable result of one runtime observation of registered thread pools.
 *
 * <p>A potential starvation result means that a visible pool was captured saturated with queued
 * work while its completed-task count did not advance across qualifying observation intervals. It
 * is sticky evidence from the observation window, not a close-time health assertion, and is not
 * proof of a dependency cycle or a particular blocking call.
 */
@Immutable
public final class ThreadPoolStarvationReport {

    /** Outcome of the observation. */
    public enum Status {
        /** All executors were visible, sampling succeeded, and no evidence was captured; deadlock is not ruled out. */
        NO_ISSUE,
        /**
         * A visible pool produced a risk snapshot during the window. Recovery does not clear the
         * evidence; sample the pool again to assess its current state.
         */
        POTENTIAL_STARVATION,
        /** Sampling failed before the observation could establish a clean result. */
        SAMPLING_FAILED,
        /** One or more registered executors could not be inspected as a thread pool. */
        INSUFFICIENT_VISIBILITY;
    }

    /**
     * A snapshot captured when one executor met the potential-starvation condition. It remains in
     * the report after recovery and does not describe the pool's state at close.
     */
    @Immutable
    public static final class Evidence {

        /** Comma-joined diagnostic registration labels, not a machine-readable list. */
        public String executor();

        /** The number of workers in the pool when the evidence was captured. */
        public int poolSize();

        /** The number of workers executing tasks when the evidence was captured. */
        public int activeCount();

        /** The number of tasks queued when the evidence was captured. */
        public int queueSize();

        /** The completed-task count when the evidence was captured. */
        public long completedTaskCount();

        /** The number of consecutive no-progress sample pairs meeting the interval threshold. */
        public int stagnantIntervals();

        @Override
        public String toString();
    }

    /** Returns the outcome of this observation. */
    public Status status();

    /** Returns whether a visible executor produced potential-starvation evidence. */
    public boolean anyIssue();

    /** Returns how many samples completed before publication. */
    public int samples();

    /** Returns the interval requested between scheduled samples. */
    public Duration samplingInterval();

    /** Returns immutable evidence for each executor that showed potential starvation. */
    public List<Evidence> evidence();

    /** Returns labels of registered executors that could not be inspected as thread pools. */
    public List<String> unsupportedExecutors();

    /** Returns the first sampling failure message, or null when sampling did not fail. */
    @Nullable
    public String failureMessage();

    /**
     * Returns a diagnostic string with the evidence and unsupported-executor counts only; the
     * snapshots and executor labels stay readable through {@link #evidence()} and {@link
     * #unsupportedExecutors()}, and printing them could expose configured labels or be
     * arbitrarily large. The sampling failure message stays readable through {@link
     * #failureMessage()} and never joins this rendering: it is a user executor's throwable text
     * and can carry credentials. The format is for logs and debuggers, not for parsing.
     */
    @Override
    public String toString();
}
```

