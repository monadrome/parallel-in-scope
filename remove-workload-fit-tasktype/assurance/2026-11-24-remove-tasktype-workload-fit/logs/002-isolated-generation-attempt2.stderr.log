+            assertThat(handler.countContaining("ct008-b")).isEqualTo(1);
+            assertThat(handler.firstContaining("ct008-b").getLevel()).isEqualTo(Level.WARNING);
+            assertThat(handler.countContaining("ct008-a")).isEqualTo(1);
